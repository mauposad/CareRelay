# CareRelay environment
#
# Copy to .env and fill in. Without ANTHROPIC_API_KEY the app still runs:
# every extraction path falls back to deterministic demo data, and the UI
# shows a "Demo extraction (no API key)" badge instead of "Live extraction".

# Required for live AI extraction (chat text + uploaded care documents).
ANTHROPIC_API_KEY=

# Ports used by scripts/dev.sh. Change these if they clash locally.
API_PORT=8788
WEB_PORT=5180
