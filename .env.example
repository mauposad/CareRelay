# CareRelay environment
#
# Everything here is optional for a local demo. With no DATABASE_URL the API
# runs an embedded Postgres under .data/ and seeds the Wilson family demo, so
# `./scripts/dev.sh` works on a fresh clone with no setup.

# Live AI extraction (chat text + uploaded care documents).
# Without it, extraction falls back to deterministic demo data and the UI says so.
ANTHROPIC_API_KEY=

# Real Postgres. Leave empty to use the embedded database.
DATABASE_URL=

# Seed the Wilson family demo circle on start. Default true in scripts/dev.sh.
SEED_DEMO=true
# Required only when seeding against a real DATABASE_URL (min 10 chars).
# With the embedded database the demo password is "carerelay-demo".
DEMO_PASSWORD=

# Ports used by scripts/dev.sh.
API_PORT=8788
WEB_PORT=5180
